# Copy this file to .env and add your key. Never commit .env.
# Get a key at https://openrouter.ai/keys
EXPO_PUBLIC_OPENROUTER_API_KEY=

# Free models, tried in order. Separate model ids from https://openrouter.ai/models with commas.
EXPO_PUBLIC_OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,liquid/lfm-2.5-2.6b:free
